data(mtcars)
head(mtcars)
str(mtcars)
dim(mtcars)
summary(mtcars)
hist(
mtcars$mpg,
main = "Distribution of MPG",
xlab = "Miles per Gallon",
col = "lightblue",
border = "black"
)
ggplot(
mtcars,
aes(x = mpg)
) +
geom_histogram(
bins = 10,
fill = "steelblue",
color = "black"
) +
labs(
title = "Distribution of MPG",
x = "MPG",
y = "Frequency"
)
# Install packages (run once)
# install.packages("tidyverse")
# install.packages("corrplot")
library(tidyverse)
library(corrplot)
ggplot(
mtcars,
aes(x = mpg)
) +
geom_histogram(
bins = 10,
fill = "steelblue",
color = "black"
) +
labs(
title = "Distribution of MPG",
x = "MPG",
y = "Frequency"
)
boxplot(
mtcars$mpg,
main = "Boxplot of MPG",
col = "lightgreen"
)
ggplot(
mtcars,
aes(y = mpg)
) +
geom_boxplot(
fill = "orange"
) +
labs(
title = "Boxplot of MPG"
)
scores <- c(
55, 60, 62, 65, 68,
70, 72, 75, 78, 80,
150
)
boxplot(
scores,
main = "Boxplot with Outlier",
col = "pink"
)
# Comparing diamond prices across different cut qualities
ggplot(mtcars, aes(x = as.factor(cyl), y = mpg, fill = as.factor(cyl))) +
geom_boxplot(alpha = 0.7, outlier.color = "#E74C3C", outlier.shape = 16) +
scale_fill_brewer(palette = "Blues") +
labs(
title = "Miles per Gallon Across Cylinders",
x = "Cylinders",
y = "MPG",
fill = "Cylinder Legend"
) +
theme_minimal() +
theme(legend.position = "none")
Q1 <- quantile(scores, 0.25)
Q3 <- quantile(scores, 0.75)
IQR_value <- IQR(scores)
lower <- Q1 - 1.5 * IQR_value
upper <- Q3 + 1.5 * IQR_value
scores[
scores < lower |
scores > upper
]
ggplot(
mtcars,
aes(
x = wt,
y = mpg
)
) +
geom_point(
size = 3,
color = "blue"
) +
labs(
title = "Weight vs MPG",
x = "Weight",
y = "Miles per Gallon"
)
ggplot(
mtcars,
aes(
x = wt,
y = mpg
)
) +
geom_point(size = 3) +
geom_smooth(
method = "lm",
se = FALSE,
color = "red"
) +
labs(
title = "Weight vs MPG"
)
cor(
mtcars$wt,
mtcars$mpg
)
cor_matrix <- cor(mtcars)
cor_matrix
corrplot(
cor_matrix,
method = "color",
type = "upper"
)
pairs(
mtcars[, 1:5],
main = "Pairwise Scatterplots"
)
